# API
CHARTALK_API_HOST=127.0.0.1
PORT=4310
CHARTALK_API_DB_PATH=./var/chartalk-api.db
CHARTALK_ADMIN_TOKEN=replace-with-at-least-24-random-characters
CHARTALK_CONTENT_PACKAGE_PATH=/srv/chartalk/content/release.json
CHARTALK_SIGNING_PUBLIC_KEY_FILE=/srv/chartalk/keys/chartalk-ed25519-public.pem
CHARTALK_SIGNING_KEY_ID=prod-2026-q3
CHARTALK_CONTENT_ASSET_ROOT=/srv/chartalk/content-assets
CHARTALK_PUBLISH_ENABLED=false
# Set only on an isolated publisher runtime, never on ordinary catalog instances.
CHARTALK_SIGNING_PRIVATE_KEY_FILE=/run/secrets/chartalk-ed25519-private.pem
CHARTALK_ALLOWED_ORIGINS=http://127.0.0.1:5173
CHARTALK_SYNC_ENABLED=false
# Required only when sync is enabled. The token is an opaque account-session
# credential supplied by the deployed auth gateway; never commit a real value.
CHARTALK_SYNC_TOKEN=replace-with-at-least-24-random-characters
CHARTALK_SYNC_ACCOUNT_ID=account.default

# Mobile public configuration. Never put a secret in EXPO_PUBLIC_*.
EXPO_PUBLIC_CHARTALK_API_URL=http://127.0.0.1:4310
# JSON map enables an overlap window during signing-key rotation. Values are base64url raw Ed25519 public keys.
EXPO_PUBLIC_CHARTALK_CONTENT_PUBLIC_KEYS={"prod-2026-q2":"replace-old-key","prod-2026-q3":"replace-current-key"}
# Legacy development-only fallback for manifests that predate signingKeyId.
EXPO_PUBLIC_CHARTALK_CONTENT_PUBLIC_KEY=
