# API
RAZVILKA_API_HOST=127.0.0.1
PORT=4310
RAZVILKA_API_DB_PATH=./var/razvilka-api.db
RAZVILKA_ADMIN_TOKEN=replace-with-at-least-24-random-characters
RAZVILKA_CONTENT_PACKAGE_PATH=/srv/razvilka/content/release.json
RAZVILKA_SIGNING_PUBLIC_KEY_FILE=/srv/razvilka/keys/razvilka-ed25519-public.pem
RAZVILKA_SIGNING_KEY_ID=prod-2026-q3
RAZVILKA_CONTENT_ASSET_ROOT=/srv/razvilka/content-assets
RAZVILKA_PUBLISH_ENABLED=false
# Set only on an isolated publisher runtime, never on ordinary catalog instances.
RAZVILKA_SIGNING_PRIVATE_KEY_FILE=/run/secrets/razvilka-ed25519-private.pem
RAZVILKA_ALLOWED_ORIGINS=http://127.0.0.1:5173
RAZVILKA_SYNC_ENABLED=false
# Required only when sync is enabled. The token is an opaque account-session
# credential supplied by the deployed auth gateway; never commit a real value.
RAZVILKA_SYNC_TOKEN=replace-with-at-least-24-random-characters
RAZVILKA_SYNC_ACCOUNT_ID=account.default

# Mobile public configuration. Never put a secret in EXPO_PUBLIC_*.
EXPO_PUBLIC_RAZVILKA_API_URL=http://127.0.0.1:4310
# JSON map enables an overlap window during signing-key rotation. Values are base64url raw Ed25519 public keys.
EXPO_PUBLIC_RAZVILKA_CONTENT_PUBLIC_KEYS={"prod-2026-q2":"replace-old-key","prod-2026-q3":"replace-current-key"}
# Legacy development-only fallback for manifests that predate signingKeyId.
EXPO_PUBLIC_RAZVILKA_CONTENT_PUBLIC_KEY=
